{
  "name": "pi-music-player",
  "productName": "PI Music Player",
  "version": "0.1.0",
  "private": true,
  "description": "AI 本地智能音乐播放器 — pi 框架大脑 · BYOK（用户自带大模型 API Key）",
  "author": "PI Music Player Contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "smoke": "cross-env SMOKE_TEST=1 electron .",
    "pack:win": "npm run build && electron-builder --win dir",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "antd": "^6.5.4",
    "express": "^5.2.1",
    "music-metadata": "^11.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typebox": "^1.3.11"
  },
  "build": {
    "appId": "com.pimusic.player",
    "productName": "PI Music Player",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!electron/**/*.map"
    ],
    "extraMetadata": {
      "main": "electron/main.mjs"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PI Music Player",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  }
}
